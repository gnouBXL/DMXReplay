{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gnouBXL/dmxreplay/blob/main/src/dmxreplay/metadata/schema.json",
  "title": "DMXReplay Manifest",
  "description": "Formal schema for the DMXReplay manifest embedded as a Matroska attachment named dmxreplay-manifest.json. See docs/SPECIFICATION.md §10.",
  "type": "object",
  "required": [
    "format",
    "version",
    "encoding",
    "fps",
    "vfr",
    "timestamp_resolution_ns",
    "width",
    "height",
    "universes",
    "created_at",
    "duration_seconds",
    "recorder"
  ],
  "properties": {
    "format": {
      "const": "DMXReplay"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "MAJOR.MINOR manifest schema version. See SPECIFICATION.md §16."
    },
    "encoding": {
      "enum": ["grayscale", "rgb_packed"],
      "description": "Pixel packing in use. See SPECIFICATION.md §5."
    },
    "fps": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Nominal frame rate. See SPECIFICATION.md §12."
    },
    "vfr": {
      "type": "boolean",
      "description": "True if the video track uses variable frame timing. See SPECIFICATION.md §13."
    },
    "timestamp_resolution_ns": {
      "type": "integer",
      "minimum": 1,
      "description": "Effective capture timestamp resolution, in nanoseconds. See SPECIFICATION.md §11."
    },
    "width": { "type": "integer", "enum": [512, 171] },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128,
      "description": "Number of active universes. See SPECIFICATION.md §4/§7."
    },
    "universes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/universeMapping" }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "recorder": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "audio": {
      "type": "object",
      "required": ["codec", "sample_rate", "channels"],
      "properties": {
        "codec": { "type": "string" },
        "sample_rate": { "type": "integer", "exclusiveMinimum": 0 },
        "channels": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },
    "external_video_ref": { "type": "string" },
    "show_name": { "type": "string" },
    "description": { "type": "string" },
    "container_version": { "type": "string" }
  },
  "additionalProperties": true,
  "$defs": {
    "universeMapping": {
      "type": "object",
      "required": ["row", "protocol", "universe"],
      "properties": {
        "row": { "type": "integer", "minimum": 0 },
        "protocol": { "enum": ["Art-Net", "sACN"] },
        "universe": { "type": "integer", "minimum": 0, "maximum": 63999 },
        "net": { "type": "integer", "minimum": 0, "maximum": 127 },
        "subnet": { "type": "integer", "minimum": 0, "maximum": 15 },
        "source_ip": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "protocol": { "const": "Art-Net" } } },
          "then": { "required": ["net", "subnet"] }
        }
      ],
      "additionalProperties": false
    }
  }
}
