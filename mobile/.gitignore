# Standard Flutter build/tooling output -- none of this is checked in, and
# none of it exists yet in this checkout since it's generated by `flutter
# create .`/`flutter pub get`/`flutter build`, none of which have been run
# here (see README.md's "Flutter validation status").
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.iml
*.g.dart
*.freezed.dart

# android/ IS committed (hand-authored, incl. a real Gradle wrapper --
# docs/MOBILE.md SS6) specifically so `flutter pub get`/`flutter build apk`
# work without the user running `flutter create` first; its own
# android/.gitignore covers the machine-specific bits within it
# (local.properties, .gradle/, build/). ios/, linux/, macos/, windows/,
# web/ are NOT present -- Phase F/J's scope is Android + iOS-later
# (docs/MOBILE.md); generate any of those with `flutter create
# --platforms=<platform> .` if needed.
